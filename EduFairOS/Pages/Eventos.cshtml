@page
@model EduFairOS.Pages.EventosModel
@{
    ViewData["Title"] = "Eventos";
}

<div class="container mt-4">
    <div class="row mb-4">
        <div class="col-12">
            <h1>Gestión de Eventos</h1>
            <p class="text-muted">Planifica y administra las ferias escolares de la institución.</p>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-5">
            <div class="card mb-4">
                <div class="card-header @(Model.NewEvento.Id > 0 ? "bg-warning text-dark" : "bg-success text-white")">
                    <h5 class="mb-0">@(Model.NewEvento.Id > 0 ? "Editar evento" : "Crear nuevo evento")</h5>
                </div>
                <div class="card-body">
                    <form method="post">
                        <input type="hidden" asp-for="NewEvento.Id" />

                        <div class="mb-3">
                            <label class="form-label">Nombre del Evento</label>
                            <input asp-for="NewEvento.Nombre" class="form-control" placeholder="Ej: Feria Científica 2026" />
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Fecha de Inicio</label>
                                <input asp-for="NewEvento.FechaInicio" class="form-control" type="datetime-local" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Fecha de Fin</label>
                                <input asp-for="NewEvento.FechaFin" class="form-control" type="datetime-local" />
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Lugar</label>
                            <input asp-for="NewEvento.Lugar" class="form-control" placeholder="Ej: Auditorio Principal" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Estado</label>
                            <select asp-for="NewEvento.Estado" class="form-select">
                                <option value="Planificacion">Planificación</option>
                                <option value="Activo">Activo</option>
                                <option value="Finalizado">Finalizado</option>
                                <option value="Cancelado">Cancelado</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Descripción</label>
                            <textarea asp-for="NewEvento.Descripcion" class="form-control"></textarea>
                        </div>

                        <button type="submit" class="btn @(Model.NewEvento.Id > 0 ? "btn-warning" : "btn-success") w-100 fw-bold">
                            @(Model.NewEvento.Id > 0 ? "Actualizar Evento" : "Registrar Evento")
                        </button>

                        @if (Model.NewEvento.Id > 0)
                        {
                            <a href="/Eventos" class="btn btn-secondary w-100 mt-2">Cancelar Edición</a>
                        }
                    </form>
                </div>
            </div>
        </div>

        <div class="col-lg-7">
            <div class="card mb-4">
                <div class="card-header bg-dark text-white">
                    <h5 class="mb-0">Historial de Eventos</h5>
                </div>
                <div class="card-body">
                    @if (Model.Eventos.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle">
                                <thead>
                                    <tr>
                                        <th>Nombre</th>
                                        <th>Lugar</th>
                                        <th>Fechas</th>
                                        <th>Estado</th>
                                        <th>Acciones</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var evento in Model.Eventos)
                                    {
                                        <tr>
                                            <td><strong>@evento.Nombre</strong></td>
                                            <td>@evento.Lugar</td>
                                            <td>
                                                <small>
                                                    @evento.FechaInicio.ToString("dd/MM/yyyy")<br />
                                                    @evento.FechaFin.ToString("dd/MM/yyyy")
                                                </small>
                                            </td>
                                            <td><span class="badge bg-primary">@evento.Estado</span></td>
                                            <td>
                                                <a asp-page="./Eventos" asp-route-editId="@evento.Id" class="btn btn-sm btn-outline-warning me-1">Editar</a>

                                                <form method="post" asp-page-handler="Delete" asp-route-id="@evento.Id" class="d-inline">
                                                    <button type="submit" class="btn btn-sm btn-outline-danger"
                                                            onclick="return confirm('¿Seguro que deseas eliminar este evento?');">
                                                        Borrar
                                                    </button>
                                                </form>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-secondary">No hay eventos registrados en el sistema.</div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
