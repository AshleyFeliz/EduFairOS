@page
@model EduFairOS.Pages.ParticipantesModel
@{
    ViewData["Title"] = "Participantes";
}

<div class="container mt-4">
    <div class="row mb-4">
        <div class="col-12">
            <h1>Directorio de Participantes</h1>
            <p class="text-muted">Registra a los estudiantes e instituciones que asisten a la feria.</p>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-4">
            <div class="card mb-4">
                <div class="card-header @(Model.NewParticipante.Id > 0 ? "bg-primary text-white" : "bg-warning text-dark")">
                    <h5 class="mb-0">@(Model.NewParticipante.Id > 0 ? "Editar Participante" : "Registrar Participante")</h5>
                </div>
                <div class="card-body">
                    <form method="post">
                        <input type="hidden" asp-for="NewParticipante.Id" />

                        <div class="mb-3">
                            <label class="form-label">Nombre Completo</label>
                            <input asp-for="NewParticipante.Nombre" class="form-control" />
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Edad</label>
                                <input asp-for="NewParticipante.Edad" class="form-control" type="number" min="5" max="20" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Grado</label>
                                <input asp-for="NewParticipante.Grado" class="form-control" />
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Institución</label>
                            <input asp-for="NewParticipante.Institucion" class="form-control" placeholder="Colegio o Escuela" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Correo Electrónico</label>
                            <input asp-for="NewParticipante.Correo" class="form-control" type="email" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Teléfono</label>
                            <input asp-for="NewParticipante.Telefono" class="form-control" />
                        </div>
                        
                        <button type="submit" class="btn @(Model.NewParticipante.Id > 0 ? "btn-primary" : "btn-warning") w-100 fw-bold">
                            @(Model.NewParticipante.Id > 0 ? "Actualizar Datos" : "Guardar")
                        </button>

                        @if (Model.NewParticipante.Id > 0)
                        {
                            <a href="/Participantes" class="btn btn-secondary w-100 mt-2">Cancelar</a>
                        }
                    </form>
                </div>
            </div>
        </div>

        <div class="col-lg-8">
            <div class="card mb-4">
                <div class="card-header bg-dark text-white">
                    <h5 class="mb-0">Lista de Inscritos</h5>
                </div>
                <div class="card-body">
                    @if (Model.Participantes.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-striped align-middle">
                                <thead>
                                    <tr>
                                        <th>Nombre</th>
                                        <th>Edad</th>
                                        <th>Grado</th>
                                        <th>Institución</th>
                                        <th>Acciones</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var p in Model.Participantes)
                                    {
                                        <tr>
                                            <td><strong>@p.Nombre</strong></td>
                                            <td>@p.Edad</td>
                                            <td>@p.Grado</td>
                                            <td>@p.Institucion</td>
                                            <td>
                                                <a asp-page="./Participantes" asp-route-editId="@p.Id" class="btn btn-sm btn-outline-primary me-1">Editar</a>
                                                
                                                <form method="post" asp-page-handler="Delete" asp-route-id="@p.Id" class="d-inline">
                                                    <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('¿Borrar a este participante del sistema?');">Borrar</button>
                                                </form>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-secondary">No hay participantes registrados todavía.</div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>